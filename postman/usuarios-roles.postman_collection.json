              "name": "CrearUsuario",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "x-functions-key", "value": "{{functionKey}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"jperez\",\n  \"email\": \"jperez@example.com\",\n  \"nombreCompleto\": \"Juan Perez\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": { "raw": "{{functionsUrl}}/usuarios", "host": ["{{functionsUrl}}"], "path": ["usuarios"] }
              }
            },
            {
              "name": "ListarUsuarios",
              "request": {
                "method": "GET",
                "header": [{ "key": "x-functions-key", "value": "{{functionKey}}" }],
                "url": { "raw": "{{functionsUrl}}/usuarios", "host": ["{{functionsUrl}}"], "path": ["usuarios"] }
              }
            },
            {
              "name": "ObtenerUsuario",
              "request": {
                "method": "GET",
                "header": [{ "key": "x-functions-key", "value": "{{functionKey}}" }],
