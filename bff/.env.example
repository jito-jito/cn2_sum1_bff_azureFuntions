# Variables de entorno requeridas para correr el BFF en producción (EC2).
# Copiar a `.env` (gitignorado) y completar con los valores reales.
# Uso: docker run --env-file bff/.env ...

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# URL base de la Function App en Azure (sin /api al final, el cliente lo agrega).
AZURE_FUNCTIONS_BASE_URL=https://fn-usuarios-roles.azurewebsites.net

# Function key de la Function App (Function App > Function Keys > default).
AZURE_FUNCTIONS_KEY=
